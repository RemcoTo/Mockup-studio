# Mockup Studio, instellingen. Kopieer dit bestand naar .env en vul in wat je nodig hebt.
# Alles werkt ook zonder de optionele onderdelen; de applicatie zegt dan zelf wat er ontbreekt.

# --- Basis -------------------------------------------------------------------------------------
# Adres waarop de studio bereikbaar is; gebruikt in e-mails, deellinks en betaalpagina's.
NUXT_APP_URL=http://localhost:3000
NUXT_APP_NAME=Mockup Studio
# Geheim voor ondertekende links. Leeg laten: wordt eenmalig gemaakt en in de datamap bewaard.
# Op een server met meerdere instanties: zelf een lange willekeurige waarde invullen.
NUXT_APP_SECRET=
# Database en bestanden.
NUXT_DATA_DIR=./data
# Nieuwe accounts toestaan (false = alleen via uitnodiging; het eerste account kan altijd).
NUXT_ALLOW_SIGNUP=true
# E-mailbevestiging verplicht maken voor AI-scènes en uitnodigen. Standaard uit: na registreren kun je
# direct alles en er wordt geen bevestigingsmail verstuurd (geen SMTP nodig). Zet op true voor een openbare server.
NUXT_REQUIRE_EMAIL_VERIFICATION=false
# Testscènes en een voorbeeldproject bij een nieuwe werkruimte (false = niet).
NUXT_SEED_DEMO=true

# --- Beeldgeneratie (alleen nodig voor nieuwe AI-scènes) ---------------------------------------
# openai = OpenAI Images API (kost geld per beeld), demo = getekende testscènes (gratis).
NUXT_IMAGE_PROVIDER=demo
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_IMAGE_MODEL=gpt-image-2
NUXT_OPENAI_BASE_URL=https://api.openai.com/v1
# Plafonds op de geschatte AI-kosten per 24 uur, in dollar.
NUXT_AI_DAILY_LIMIT_USD=25
NUXT_AI_WORKSPACE_DAILY_LIMIT_USD=5

# --- Betalen (optioneel) -----------------------------------------------------------------------
# off = geen credits en geen limieten (eigen installatie), credits = abonnementen en credits.
NUXT_BILLING_MODE=off
# Stripe: geheime sleutel (sk_test_... om te testen) en het ondertekeningsgeheim van de webhook (whsec_...).
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=

# --- E-mail (optioneel) ------------------------------------------------------------------------
# Leeg: e-mails komen in de uitbak (zichtbaar voor beheerders onder Instellingen, Systeem).
# Voorbeeld: smtps://gebruiker:wachtwoord@smtp.voorbeeld.nl:465
NUXT_SMTP_URL=
NUXT_MAIL_FROM=

# --- Website-import ----------------------------------------------------------------------------
# Leeg: de browser uit `npm run browsers`. Anders: pad naar een Chromium- of Chrome-programma.
NUXT_CHROMIUM_PATH=
NUXT_CAPTURE_MAX_CONCURRENCY=2
# Alleen voor lokale tests: import van interne adressen toestaan. In productie altijd false.
NUXT_CAPTURE_ALLOW_PRIVATE=false

# --- Bestanden en beeldwerk --------------------------------------------------------------------
NUXT_UPLOAD_MAX_MB=40
# Aantal rekenprocessen voor beeldwerk (leeg = automatisch, 0 = geen aparte processen).
IMAGING_WORKERS=
# Kleurprofiel voor TIFF-export in CMYK (leeg = standaardprofiel). Pad naar een .icc-bestand van je drukker.
NUXT_CMYK_ICC=
# ffmpeg voor scrollvideo's. Leeg: de meegeleverde versie (pakket ffmpeg-static).
NUXT_FFMPEG_PATH=

# --- Foutmeldingen (optioneel) -----------------------------------------------------------------
# DSN van Sentry of GlitchTip; leeg = alleen de eigen logbestanden.
NUXT_SENTRY_DSN=
NUXT_RELEASE=
